<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>SofkaBankRegister</title>
</head>
<body>
    <div class="login-from">
        <div class="content-register">
            <h1>Formulario de Registro</h1>
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error-message">
                    <p><%= error %></p>
                </div>
            <% } %>
            <form action="auth/register" method="post">
                <div class="form-group">
                    <label for="username">Nombre de usuario</label>
                    <input type="text" placeholder="Nombre de usuario" name="nombre" required autofocus="">
                </div>
                <div class="form-group">
                    <label for="email">Correo electrónico</label>
                    <input type="email" placeholder="Correo" name="correo" required  title="Debeserdios" autofocus="">
                </div>
                <div class="form-group">
                    <label for="username">Numero identificacion</label>
                    <input type="text" placeholder="Numero identificacion" name="numeroIdetificacion" required pattern="[0-9\-]{8,}" title="Debe tener al menos 8 números" autofocus="">
                </div>
                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <input type="password" placeholder="Contraseña" name="contrasena" required pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*\W).{8,}" title="La contraseña debe tener al menos 8 caracteres, incluyendo una letra mayúscula, una letra minúscula, un número y un carácter especial." autofocus="">
                </div>
                <button class="btn" type="submit">Registrarse</button>
            </div>
        </form>
    </div>
</body>
</html>